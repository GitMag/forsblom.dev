---
// One screenshot as a numbered figure: the picture (AVIF and WebP at several widths) on a soft panel in its
// project's colour (the nearest [data-project] ancestor sets it), with a hairline outline and a caption from its
// alt text, "Figure N. …". The number comes from a CSS counter (global.css).
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** The sizes attribute: how wide the picture is laid out, e.g. "(min-width: 48rem) 20rem, 62vw". */
  sizes: string;
  loading?: "lazy" | "eager";
  caption?: boolean;
  class?: string;
}

const { src, alt, sizes, loading = "lazy", caption = true, class: cls } = Astro.props;
const portrait = src.height > src.width;
const candidates = portrait ? [280, 360, 480, 720] : [480, 720, 960, 1280, 1600, 1920];
const widths = [...new Set([...candidates.filter((w) => w < src.width), src.width])];
---

<figure class:list={["fig", portrait ? "fig-portrait" : "fig-landscape", cls]}>
  <div class="plate">
    <Picture
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      loading={loading}
      fetchpriority={loading === "eager" ? "high" : undefined}
      decoding="async"
    />
  </div>
  {caption && <figcaption>{alt}</figcaption>}
</figure>
