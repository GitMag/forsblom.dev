---
// A short muted clip as a numbered figure, in the same style as Figure.astro: on a field in the project's family
// colour, here with the clip's own poster blurred behind it like the visualizer's backdrop, a hairline outline and
// a "Figure N." caption. It plays on its own, muted and looping, like a moving screenshot.
import { existsSync } from "node:fs";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  /** The clip in public/media/, e.g. /media/clip.mp4. */
  src: string;
  /** Shown until the clip starts, and where video doesn't play. */
  poster: ImageMetadata;
  caption: string;
}

const { src, poster, caption } = Astro.props;
// A WebM copy next to the MP4 (same name) is offered too, for browsers without H.264.
const webm = src.replace(/\.mp4$/, ".webm");
const hasWebm = existsSync(`public${webm}`);
const still = await getImage({ src: poster, width: Math.min(poster.width, 1600), format: "webp" });
const blur = await getImage({ src: poster, width: 640, format: "webp" });
---

<figure class="fig fig-landscape fig-video">
  <div class="plate">
    <img class="bg" src={blur.src} alt="" aria-hidden="true" width={blur.attributes.width} height={blur.attributes.height} loading="lazy" decoding="async" />
    <video
      poster={still.src}
      width={poster.width}
      height={poster.height}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      disablepictureinpicture
      aria-label={caption}>
      <source src={src} type="video/mp4" />
      {hasWebm && <source src={webm} type="video/webm" />}
    </video>
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .plate {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
    filter: blur(40px) saturate(1.25);
    transform: scale(1.3);
  }

  .plate::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(0 0 0 / 0.4);
  }
</style>
