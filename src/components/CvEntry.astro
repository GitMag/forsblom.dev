---
// One job or school on the CV page as a ruled row: the period on the left; the organisation, the role or field
// and the bullet points on the right. A point is a string, or an object with a text and a link (the thesis).
interface Point {
  text: string;
  link?: { label: string; url: string };
}

interface Props {
  org: string;
  role: string;
  from?: string;
  to?: string;
  place?: string;
  points?: (string | Point)[];
}

const { org, role, from, to, place, points = [] } = Astro.props;
const period = from ? `${from} – ${to ?? "present"}` : (to ?? "");
const items = points.map((p) => (typeof p === "string" ? { text: p } : p));
---

<article class="row">
  <p class="period mono">{period}</p>
  <div class="body">
    <h3>{org}</h3>
    <p class="role">
      {role}{place && <span class="place"> · {place}</span>}
    </p>
    {
      items.length > 0 && (
        <ul class="points">
          {items.map((p) => (
            <li>
              {p.text}
              {p.link && (
                <>
                  {" "}
                  <a href={p.link.url}>{p.link.label}</a>
                </>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .row {
    display: grid;
    gap: 0.25rem 1.5rem;
    padding-block: 0.9rem;
    border-top: 1px solid var(--line);
    break-inside: avoid;
  }

  @media (min-width: 40rem) {
    .row {
      grid-template-columns: 9rem minmax(0, 1fr);
    }
  }

  .period {
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-2);
    padding-top: 0.2rem;
    white-space: nowrap;
  }

  .body {
    display: grid;
    gap: 0.25rem;
  }

  .role {
    color: var(--ink-2);
  }

  .points {
    margin-top: 0.3rem;
    padding-left: 1.1em;
    list-style: square;
    max-width: var(--measure);
    text-wrap: pretty;
  }

  .points li + li {
    margin-top: 0.25rem;
  }

  .points li::marker {
    color: var(--ink-2);
  }

  @media print {
    .row {
      padding-block: 0.5rem;
      grid-template-columns: 8rem minmax(0, 1fr);
    }

    .points {
      margin-top: 0.15rem;
    }

    .points li + li {
      margin-top: 0.1rem;
    }

    /* The thesis link: write the address out. */
    .points a::after {
      content: " (" attr(href) ")";
      color: var(--ink-2);
      font-size: 0.85em;
    }
  }
</style>
