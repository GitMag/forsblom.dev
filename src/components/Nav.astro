---
// The top bar: the name (a link home) and two links, under one rule. Short enough for a phone, so no menu button.
interface Props {
  name: string;
}
const { name } = Astro.props;
const path = Astro.url.pathname;
const current = (prefix: string) => (path.startsWith(prefix) ? "page" : undefined);
---

<header class="site-header">
  <div class="container row">
    <a class="wordmark" href="/" aria-current={path === "/" ? "page" : undefined}>{name}</a>
    <nav aria-label="Site">
      <a href="/projects/" aria-current={current("/projects")}>Projects</a>
      <a href="/about/" aria-current={current("/about")}>About / CV</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--ink);
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.25rem;
    font-size: 0.9rem;
  }

  .row a {
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark {
    font-weight: 600;
  }

  nav {
    display: flex;
    gap: clamp(1rem, 3vw, 1.75rem);
    font-weight: 500;
  }

  nav a {
    padding-block: 0.2rem;
    border-bottom: 2px solid transparent;
  }

  nav a:hover {
    border-bottom-color: var(--line);
  }

  nav a[aria-current="page"] {
    color: var(--signal);
    border-bottom-color: var(--signal);
  }
</style>
