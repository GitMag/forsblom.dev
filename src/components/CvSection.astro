---
// One section of the CV page: a label on the left (above, on a phone) and the content on the right.
interface Props {
  title: string;
  id: string;
  /** Print only: hidden on screen. */
  printOnly?: boolean;
}
const { title, id, printOnly = false } = Astro.props;
---

<section class:list={["cv-section", { "print-only": printOnly }]} id={id}>
  <h2>{title}</h2>
  <div class="content">
    <slot />
  </div>
</section>

<style>
  .cv-section {
    display: grid;
    gap: 0.75rem 3rem;
    padding-block: 2.25rem;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 48rem) {
    .cv-section {
      grid-template-columns: 11rem 1fr;
    }
  }

  h2 {
    font-size: 1.5rem;
    color: var(--fg);
  }

  .content {
    display: grid;
    gap: 1.75rem;
    min-width: 0;
  }

  .print-only {
    display: none;
  }

  @media print {
    .cv-section {
      grid-template-columns: 9rem 1fr;
      padding-block: 0.9rem;
      gap: 0.4rem 1.5rem;
    }

    .print-only {
      display: grid;
    }

    .content {
      gap: 0.7rem;
    }

    h2 {
      font-size: 1.15rem;
    }
  }
</style>
