---
// The document header of a page, like a datasheet's title block: a ruled box with the title and subtitle, the
// page's own content under them (a description, buttons), a photo cell on the right when there is a photo, and a
// row of small labelled fields below (pass them in the "fields" slot as <div><dt>Label</dt><dd>Value</dd></div>).
// With `project` it is the project's cover: filled with the app's family colour (global.css), the grid drawn in
// light hairlines, light ink; `backdrop` puts a picture behind it, dimmed in the colour or blurred.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Zoomable from "./Zoomable.astro";

interface Props {
  title: string;
  subtitle?: string;
  photo?: ImageMetadata;
  photoAlt?: string;
  /** A different photo for print (the CV PDF); the screen keeps `photo`. */
  printPhoto?: ImageMetadata;
  /** The sizes attribute for the photo; see the widths in the component. */
  photoSizes?: string;
  /** A project's slug: the block becomes the project's cover in its family colour (see /accents.css). */
  project?: string;
  /** A picture behind a cover (a map, album art), dimmed in the family colour or blurred. */
  backdrop?: ImageMetadata;
  backdropStyle?: "dim" | "blur";
  /** A cover's product shot: the app's top screenshot, shown in the cover's right-hand space on wide screens. */
  shot?: { src: ImageMetadata; alt: string };
  /** A lightbox group for the shot: it opens large when clicked (the page needs <Lightbox />). */
  shotZoom?: string;
}

const {
  title,
  subtitle,
  photo,
  photoAlt = "",
  printPhoto,
  photoSizes = "(min-width: 48rem) 11rem, 6.5rem",
  project,
  backdrop,
  backdropStyle = "dim",
  shot,
  shotZoom,
} = Astro.props;
const shotPortrait = shot ? shot.src.height > shot.src.width : false;
const widthsFor = (img: ImageMetadata) => [...new Set([...[200, 300, 400, 600].filter((w) => w < img.width), img.width])];
---

<header
  class:list={["tb", { "has-photo": !!photo, "has-shot": !!shot, cover: !!project, [`bg-${backdropStyle}`]: !!backdrop }]}
  data-project={project}>
  {
    backdrop && (
      <div class="tb-bg" aria-hidden="true">
        <Picture
          src={backdrop}
          alt=""
          widths={[...[720, 1080, 1440].filter((w) => w < backdrop.width), backdrop.width]}
          sizes="(min-width: 72rem) 68rem, 100vw"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          loading="eager"
          decoding="async"
        />
      </div>
    )
  }
  <div class="tb-main">
    <h1>{title}</h1>
    {subtitle && <p class="tb-sub">{subtitle}</p>}
    <slot />
  </div>
  {
    photo && (
      <div class="tb-photo">
        <div class:list={["pic", { "screen-only": !!printPhoto }]}>
          <Picture
            src={photo}
            alt={photoAlt}
            widths={widthsFor(photo)}
            sizes={photoSizes}
            formats={["avif", "webp"]}
            fallbackFormat="jpg"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        {printPhoto && (
          <div class="pic print-only">
            <Picture
              src={printPhoto}
              alt={photoAlt}
              widths={widthsFor(printPhoto)}
              sizes="26mm"
              formats={["avif", "webp"]}
              fallbackFormat="jpg"
              loading="eager"
            />
          </div>
        )}
      </div>
    )
  }
  {
    shot && (
      <div class:list={["tb-shot", shotPortrait ? "portrait" : "landscape"]}>
        {shotZoom ? (
          <Zoomable src={shot.src} alt={shot.alt} group={shotZoom}>
            <Picture
              src={shot.src}
              alt={shot.alt}
              widths={(shotPortrait ? [240, 360, 480, 720] : [480, 720, 960, 1280]).filter((w) => w <= shot.src.width)}
              sizes={shotPortrait ? "(min-width: 64rem) 13.5rem, 1px" : "(min-width: 64rem) 28rem, 1px"}
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              loading="lazy"
              decoding="async"
            />
          </Zoomable>
        ) : (
          <Picture
            src={shot.src}
            alt={shot.alt}
            widths={(shotPortrait ? [240, 360, 480, 720] : [480, 720, 960, 1280]).filter((w) => w <= shot.src.width)}
            sizes={shotPortrait ? "(min-width: 64rem) 13.5rem, 1px" : "(min-width: 64rem) 28rem, 1px"}
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            loading="lazy"
            decoding="async"
          />
        )}
      </div>
    )
  }
  <dl class="tb-fields">
    <slot name="fields" />
  </dl>
</header>

<style>
  .tb {
    --tb-line: var(--ink);
    --tb-cell-line: var(--line);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    border: 1px solid var(--tb-line);
    margin-top: 2rem;
  }

  .tb-main {
    grid-column: 1;
    grid-row: 1;
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    padding: 1.5rem;
  }

  .tb-main h1 {
    margin-bottom: 0.25rem;
  }

  .tb-sub {
    font-size: 1.05rem;
    color: var(--ink-2);
  }

  .tb-photo {
    grid-column: 2;
    grid-row: 1 / span 2;
    width: 11rem;
    border-left: 1px solid var(--tb-line);
  }

  .tb-photo .pic {
    height: 100%;
  }

  .tb-photo .print-only {
    display: none;
  }

  .tb-photo :global(picture),
  .tb-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 15%;
  }

  /* A cover's product shot, like the product photo on a datasheet's cover: only where the cover has spare room on
     the right (from 64rem); on narrower screens the gallery right under the cover shows the same picture. */
  .tb-shot {
    display: none;
  }

  @media (min-width: 64rem) {
    .has-shot .tb-shot {
      display: block;
      grid-column: 2;
      grid-row: 1;
      align-self: center;
      justify-self: end;
      padding: 2rem 2rem 2rem 1rem;
    }

    .has-shot .tb-fields {
      grid-column: 1 / -1;
    }

    .tb-shot :global(picture),
    .tb-shot :global(img) {
      display: block;
    }

    .tb-shot :global(img) {
      border: 1px solid var(--field-line, var(--line));
      box-shadow: 0 1.25rem 3rem rgb(0 0 0 / 0.35);
    }

    .tb-shot.portrait :global(img) {
      width: 13.5rem;
      height: auto;
    }

    .tb-shot.landscape :global(img) {
      width: 28rem;
      height: auto;
    }
  }

  /* The fields: every cell draws a hairline on its top and left; the outer ones are pulled under the box's own
     border and clipped, so only the lines between cells remain. */
  .tb-fields {
    grid-column: 1;
    grid-row: 2;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    border-top: 1px solid var(--tb-line);
    overflow: hidden;
  }

  .tb-fields > :global(div) {
    padding: 0.7rem 1.5rem;
    border-top: 1px solid var(--tb-cell-line);
    border-left: 1px solid var(--tb-cell-line);
    margin: -1px 0 0 -1px;
    min-width: 0;
  }

  .tb-fields :global(dt) {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-bottom: 0.15rem;
  }

  .tb-fields :global(dd) {
    margin: 0;
    font-size: 0.9rem;
    overflow-wrap: anywhere;
  }

  .tb-fields :global(ul) {
    list-style: none;
    padding: 0;
  }

  /* ---- A project's cover: the family colour fills the block, the grid is drawn in light hairlines. ---- */
  .cover {
    --tb-line: var(--field-line);
    --tb-cell-line: var(--field-line);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: var(--field-ink);
    background: var(--field-bg);
    border-top: 5px solid var(--accent);
  }

  .cover .tb-main {
    padding: 2rem 1.5rem 1.75rem;
  }

  .cover .tb-sub,
  .cover .tb-fields :global(dt) {
    color: var(--field-ink-2);
  }

  .cover :global(a:not(.btn)) {
    color: var(--field-ink);
  }

  .cover :global(.status .led) {
    background: var(--field-accent);
  }

  .cover :global(.btn) {
    color: var(--field-ink);
    border-color: rgb(255 255 255 / 0.6);
    background: transparent;
  }

  .cover :global(.btn:hover) {
    background: rgb(255 255 255 / 0.12);
  }

  .cover :global(.btn-primary) {
    color: var(--field);
    background: var(--field-ink);
    border-color: var(--field-ink);
  }

  .cover :global(.btn-primary:hover) {
    background: rgb(255 255 255 / 0.88);
  }

  /* The picture behind a cover. */
  .tb-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .tb-bg :global(picture),
  .tb-bg :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tb-bg::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  /* dim: the picture shows through the family colour as texture, a little more on the right where the text isn't.
     It is enlarged and softened, so its own panels and labels don't read as text. */
  .bg-dim .tb-bg :global(img) {
    object-position: 50% 50%;
    filter: saturate(0.9) blur(2px);
    /* Enlarged toward the upper left, so the screenshot's legend chips (top) and time-picker panel (bottom right)
       fall outside the cover and only the coloured map remains. */
    transform: scale(1.7);
    transform-origin: 20% 35%;
  }

  .bg-dim .tb-bg::after {
    background: linear-gradient(100deg, oklch(from var(--field) l c h / 0.96) 0%, oklch(from var(--field) l c h / 0.86) 55%, oklch(from var(--field) l c h / 0.74) 100%);
  }

  /* blur: album art, blurred and darkened, like the visualizer's own backdrop. */
  .bg-blur .tb-bg :global(img) {
    filter: blur(44px) saturate(1.25);
    transform: scale(1.25);
  }

  .bg-blur .tb-bg::after {
    background: linear-gradient(180deg, rgb(0 0 0 / 0.5), rgb(0 0 0 / 0.35));
  }

  /* Phones: the photo sits beside the title only, the fields stack under both. */
  @media (max-width: 47.99rem) {
    .tb-main,
    .cover .tb-main {
      padding: 1.1rem 1rem;
    }

    .cover .tb-main {
      padding-top: 1.5rem;
    }

    .tb-photo {
      grid-row: 1;
      width: 6.5rem;
    }

    .tb-fields {
      grid-column: 1 / -1;
      grid-template-columns: 1fr;
    }

    .tb-fields > :global(div) {
      padding: 0.6rem 1rem;
    }
  }

  @media print {
    .tb-photo .screen-only {
      display: none;
    }

    .tb-photo .print-only {
      display: block;
    }

    .tb {
      margin-top: 0;
    }

    .tb-main {
      padding: 0.8rem 1rem;
      gap: 0.3rem;
    }

    .tb-sub {
      font-size: 0.95rem;
    }

    .tb-photo {
      width: 26mm;
    }

    .tb-fields {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tb-fields > :global(div) {
      padding: 0.45rem 1rem;
    }
  }
</style>
