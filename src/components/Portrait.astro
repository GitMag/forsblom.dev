---
// The portrait photo from site.yaml in a rounded frame. Renders nothing when site.yaml has no photo.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src?: ImageMetadata;
  alt?: string;
  /** The sizes attribute: how wide the photo is laid out, e.g. "(min-width: 56rem) 17rem, 5.5rem". */
  sizes: string;
  loading?: "lazy" | "eager";
  class?: string;
}

const { src, alt = "", sizes, loading = "eager", class: cls } = Astro.props;
const widths = src ? [...new Set([...[160, 240, 320, 480, 640].filter((w) => w < src.width), src.width])] : [];
---

{
  src && (
    <div class:list={["portrait", cls]}>
      <Picture
        src={src}
        alt={alt}
        widths={widths}
        sizes={sizes}
        formats={["avif", "webp"]}
        fallbackFormat="jpg"
        loading={loading}
        fetchpriority={loading === "eager" ? "high" : undefined}
        decoding="async"
      />
    </div>
  )
}

<style>
  .portrait picture,
  .portrait img {
    display: block;
    width: 100%;
    height: auto;
  }

  .portrait img {
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  @media print {
    .portrait img {
      border-radius: 2.5mm;
      box-shadow: none;
    }
  }
</style>
