---
// One screenshot inside its device frame: phone, tv, browser or none (a plain rounded picture).
// The picture gets AVIF and WebP sources at several widths; the frame's bezel scales with its width (global.css).
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  frame: "phone" | "tv" | "browser" | "none";
  /** The sizes attribute: how wide the picture is laid out, e.g. "(min-width: 56rem) 16rem, 44vw". */
  sizes: string;
  loading?: "lazy" | "eager";
  class?: string;
}

const { src, alt, frame, sizes, loading = "lazy", class: cls } = Astro.props;
const portrait = src.height > src.width;
const candidates = portrait ? [280, 360, 480, 720] : [480, 720, 960, 1280, 1600, 1920];
const widths = [...new Set([...candidates.filter((w) => w < src.width), src.width])];
---

<div class:list={["frame-box", `frame-${frame}`, cls]}>
  <div class="frame">
    {
      frame === "browser" && (
        <div class="frame-bar" aria-hidden="true">
          <i />
          <i />
          <i />
          <span />
        </div>
      )
    }
    <Picture
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      loading={loading}
      fetchpriority={loading === "eager" ? "high" : undefined}
      decoding="async"
    />
  </div>
  {frame === "tv" && <div class="frame-stand" aria-hidden="true" />}
</div>
