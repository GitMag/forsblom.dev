---
// The page footer: the site and its revision, the contact links from site.yaml, and the note that links to the
// source.
interface Props {
  email: string;
  links: { label: string; url: string }[];
  note: string;
  sourceUrl: string;
  host: string;
  revision: string;
}
const { email, links, note, sourceUrl, host, revision } = Astro.props;
---

<footer class="site-footer">
  <div class="container">
    <div class="row">
      <p class="mono id">{host} · Rev {revision}</p>
      <ul class="links">
        <li><a href={`mailto:${email}`}>{email}</a></li>
        {links.map((l) => <li><a href={l.url} rel="me">{l.label}</a></li>)}
      </ul>
    </div>
    <p class="note"><a href={sourceUrl}>{note}</a></p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    border-top: 1px solid var(--ink);
    padding-block: 1.25rem 2rem;
    font-size: 0.85rem;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 2rem;
  }

  .id {
    font-size: 0.75rem;
    color: var(--ink-2);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    list-style: none;
    padding: 0;
  }

  .note {
    margin-top: 0.75rem;
    color: var(--ink-2);
  }

  .note a {
    color: inherit;
    text-decoration: none;
  }

  .note a:hover {
    text-decoration: underline;
  }
</style>
