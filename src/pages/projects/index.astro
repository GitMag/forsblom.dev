---
// Every project: the selection table, then one entry per project, in `order`.
import Base from "../../layouts/Base.astro";
import TitleBlock from "../../components/TitleBlock.astro";
import Section from "../../components/Section.astro";
import SelectionTable from "../../components/SelectionTable.astro";
import ProjectEntry from "../../components/ProjectEntry.astro";
import { getEntry } from "astro:content";
import { listProjects, projectUrl } from "../../lib/projects";
import { revision } from "../../lib/site";
import { breadcrumbNode, graph, personId } from "../../lib/schema";

const projects = await listProjects();
const site = (await getEntry("site", "site"))!.data;

// Structured data: a list of the projects.
const jsonLd = graph(
  {
    "@type": "CollectionPage",
    url: new URL("/projects/", Astro.site).href,
    name: site.seo.projectsTitle,
    description: site.seo.projectsDescription,
    author: { "@id": personId(Astro.site!) },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: projects.map((project, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: project.data.title,
        url: new URL(projectUrl(project), Astro.site).href,
      })),
    },
  },
  breadcrumbNode(Astro.site!, [["Home", "/"], ["Projects", "/projects/"]]),
);
---

<Base title={site.seo.projectsTitle} description={site.seo.projectsDescription}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </Fragment>
  <TitleBlock title="Projects">
    <Fragment slot="fields">
      <div>
        <dt>Entries</dt>
        <dd>{projects.length}</dd>
      </div>
      <div>
        <dt>Revision</dt>
        <dd>{revision}</dd>
      </div>
    </Fragment>
  </TitleBlock>

  <Section title="Projects" id="projects">
    <SelectionTable projects={projects} caption="Project selection guide" />
    <div class="entries">{projects.map((p, i) => <ProjectEntry project={p} eager={i === 0} />)}</div>
  </Section>
</Base>

<style>
  .entries {
    margin-top: 2.5rem;
  }
</style>
