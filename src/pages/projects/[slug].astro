---
// One project: the title block (title, subtitle, description, links, type, status, code), the screenshots as
// numbered figures, the Markdown body as numbered sections, the specification table and the previous/next links.
import Base from "../../layouts/Base.astro";
import TitleBlock from "../../components/TitleBlock.astro";
import Section from "../../components/Section.astro";
import Figure from "../../components/Figure.astro";
import VideoFigure from "../../components/VideoFigure.astro";
import SpecTable from "../../components/SpecTable.astro";
import { getImage } from "astro:assets";
import { render } from "astro:content";
import { listProjects, projectUrl, type Project } from "../../lib/projects";
import { bareUrl, revision } from "../../lib/site";

export async function getStaticPaths() {
  const projects = await listProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

interface Props {
  project: Project;
  prev?: Project;
  next?: Project;
}

const { project, prev, next } = Astro.props;
const { title, subtitle, tagline, application, tags, stack, specs, links, code, images, video } = project.data;
const { Content } = await render(project);
const status = specs.find((s) => s.label.toLowerCase() === "status")?.value;

// The share image: the first landscape screenshot, or the site-wide image when there is none.
const landscape = images.find((i) => i.src.width > i.src.height);
const share = landscape ? await getImage({ src: landscape.src, width: 1200, format: "jpg" }) : undefined;

// The gallery's rows. Consecutive phone screenshots form one group: a sideways-scrolling row on a phone, and on
// wider screens rows of at most four (6 → 3 + 3). A landscape screenshot stands alone; an odd run of them puts the
// first one on a row of its own, then pairs (3 → 1 + 2). A "break" is a full-width, zero-height flex item on wide
// screens that starts a new row; it is hidden on a phone.
type Image = (typeof images)[number];
type Cell = { img: Image; index: number } | "break";
const isPortrait = (img: Image) => img.src.height > img.src.width;
const rowSizes = (n: number, max: number) => {
  const rows = Math.ceil(n / max);
  const base = Math.floor(n / rows);
  const extra = n % rows;
  return Array.from({ length: rows }, (_, i) => base + (i < extra ? 1 : 0));
};
const groups: { scroll: boolean; cells: Cell[] }[] = [];
for (let i = 0; i < images.length; ) {
  const portrait = isPortrait(images[i]);
  let j = i;
  while (j < images.length && isPortrait(images[j]) === portrait) j++;
  const run = images.slice(i, j).map((img, k) => ({ img, index: i + k }));
  if (portrait) {
    const cells: Cell[] = [];
    let at = 0;
    for (const size of rowSizes(run.length, 4)) {
      if (at > 0) cells.push("break");
      cells.push(...run.slice(at, at + size));
      at += size;
    }
    groups.push({ scroll: true, cells });
  } else {
    run.forEach((cell, k) => {
      const alone = k === 0 && run.length > 1 && run.length % 2 === 1;
      groups.push({ scroll: false, cells: alone ? [cell, "break"] : [cell] });
    });
  }
  i = j;
}
---

<Base
  title={`${title}: ${subtitle}`}
  description={tagline}
  ogType="article"
  image={share?.src}
  imageWidth={share ? Number(share.attributes.width) : undefined}
  imageHeight={share ? Number(share.attributes.height) : undefined}
  project={project.id}
>
  <TitleBlock title={title} subtitle={subtitle} project={project.id}>
    <p class="lead">{tagline}</p>
    {
      links.length > 0 && (
        <div class="actions">
          {links.map((l, i) => (
            <a class:list={["btn", { "btn-primary": i === 0 }]} href={l.url}>
              {l.label} ↗
            </a>
          ))}
        </div>
      )
    }
    <Fragment slot="fields">
      <div>
        <dt>Type</dt>
        <dd>{tags.join(", ")}</dd>
      </div>
      {
        status && (
          <div>
            <dt>Status</dt>
            <dd>
              <span class="status">
                <i class="led" aria-hidden="true" />
                {status}
              </span>
            </dd>
          </div>
        )
      }
      <div>
        <dt>Code</dt>
        <dd>{code === "private" ? "Private" : <a href={code}>{bareUrl(code)}</a>}</dd>
      </div>
      <div>
        <dt>Revision</dt>
        <dd>{revision}</dd>
      </div>
    </Fragment>
  </TitleBlock>

  {
    application && (
      <aside class="callout">
        <p class="label">Typical application</p>
        <p>{application}</p>
      </aside>
    )
  }

  {
    video && (
      <div class="clip">
        <VideoFigure src={video.src} poster={video.poster} caption={video.caption} />
      </div>
    )
  }

  {
    images.length > 0 && (
      <div class="gallery">
        {groups.map((group) => (
          <div class:list={["group", { scroll: group.scroll }]}>
            {group.cells.map((cell) =>
              cell === "break" ? (
                <div class="break" />
              ) : (
                <div class:list={["shot", `shot-${cell.img.frame}`]}>
                  <Figure
                    src={cell.img.src}
                    alt={cell.img.alt}
                    loading={cell.index === 0 ? "eager" : "lazy"}
                    sizes={isPortrait(cell.img) ? "(min-width: 48rem) 20rem, 62vw" : "(min-width: 48rem) 68rem, 88vw"}
                  />
                </div>
              ),
            )}
          </div>
        ))}
      </div>
    )
  }

  <div class="prose">
    <Content />
  </div>

  <Section title="Specifications" id="specifications">
    <SpecTable specs={specs} stack={stack} code={code} caption={`${title} at a glance`} />
  </Section>

  <nav class="pager" aria-label="Other projects">
    {
      prev && (
        <a class="prev" href={projectUrl(prev)}>
          <span class="label">Previous</span>
          <span class="name">← {prev.data.title}</span>
        </a>
      )
    }
    {
      next && (
        <a class="next" href={projectUrl(next)}>
          <span class="label">Next</span>
          <span class="name">{next.data.title} →</span>
        </a>
      )
    }
  </nav>
</Base>

<style>
  .actions {
    margin-top: 0.5rem;
  }

  /* The clip, above the screenshots */
  .clip {
    margin-top: 2.5rem;
  }

  .clip + .gallery {
    margin-top: 1.5rem;
  }

  /* The screenshots */
  .gallery {
    display: grid;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .shot {
    min-width: 0;
  }

  .shot-phone {
    --r: 0.462;
  }

  .shot-tv {
    --r: 1.78;
  }

  .shot-browser {
    --r: 1.6;
  }

  .shot-none {
    --r: 1.5;
  }

  .break {
    display: none;
  }

  @media (max-width: 47.99rem) {
    .group.scroll {
      display: flex;
      gap: 1rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 0.75rem;
      scrollbar-width: thin;
    }

    .group.scroll .shot {
      flex: 0 0 auto;
      scroll-snap-align: start;
    }

    .shot-phone {
      width: min(62vw, 18rem);
    }
  }

  /* Wide screens: one justified gallery. Every frame in a row has the same width share, because each frame's flex
     basis and grow follow its aspect ratio (--r). */
  @media (min-width: 48rem) {
    .gallery {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 1.5rem;
    }

    .group {
      display: contents;
    }

    .shot {
      flex: var(--r) 1 calc(var(--r) * 18rem);
    }

    .shot-phone {
      max-width: 20rem;
    }

    .break {
      display: block;
      flex-basis: 100%;
      height: 0;
    }
  }

  .prose {
    margin-top: 0.5rem;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .pager a {
    display: grid;
    gap: 0.2rem;
    color: var(--ink);
    text-decoration: none;
  }

  .pager .next {
    margin-left: auto;
    text-align: right;
  }

  .pager .name {
    font-weight: 600;
  }

  .pager a:hover .name {
    color: var(--signal);
  }
</style>
