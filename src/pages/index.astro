---
// The home page: the title block (name, role, photo, what I'm doing now, contact), 1 Overview (the intro and
// three buttons) and 2 Projects (the selection table, then one entry per project).
import Base from "../layouts/Base.astro";
import TitleBlock from "../components/TitleBlock.astro";
import Section from "../components/Section.astro";
import SelectionTable from "../components/SelectionTable.astro";
import ProjectEntry from "../components/ProjectEntry.astro";
import { getEntry } from "astro:content";
import { listProjects } from "../lib/projects";
import { bareUrl, revision, roleFrom } from "../lib/site";

const site = (await getEntry("site", "site"))!.data;
const projects = await listProjects();
const featured = projects.filter((p) => p.data.card === "featured");
const small = projects.filter((p) => p.data.card === "small");
const role = roleFrom(site.title);

// Structured data for search engines.
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: Astro.site?.href,
  jobTitle: role,
  email: `mailto:${site.email}`,
  address: { "@type": "PostalAddress", addressLocality: site.location },
  sameAs: site.links.map((l) => l.url),
};
---

<Base>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />
  </Fragment>

  <TitleBlock title={site.name} subtitle={`${role} · ${site.location}`} photo={site.photo} photoAlt={site.photoAlt}>
    <Fragment slot="fields">
      <div>
        <dt>Currently</dt>
        <dd><ul>{site.currently.map((line) => <li>{line}</li>)}</ul></dd>
      </div>
      <div>
        <dt>Contact</dt>
        <dd>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          {site.links.map((l) => <><br /><a href={l.url}>{bareUrl(l.url)}</a></>)}
        </dd>
      </div>
      <div>
        <dt>Revision</dt>
        <dd>{revision}</dd>
      </div>
    </Fragment>
  </TitleBlock>

  <Section title="Overview" id="overview">
    <p class="lead">{site.hero}</p>
    <div class="actions">
      <a class="btn btn-primary" href="#projects">Projects</a>
      <a class="btn" href="/about/">About / CV</a>
      <a class="btn" href={`mailto:${site.email}`}>Email</a>
    </div>
  </Section>

  <Section title="Projects" id="projects">
    <SelectionTable projects={projects} caption="Project selection guide" />
    <div class="entries">
      {featured.map((p, i) => <ProjectEntry project={p} eager={i === 0} />)}
      {small.map((p) => <ProjectEntry project={p} compact />)}
    </div>
  </Section>
</Base>

<style>
  .actions {
    margin-top: 1.5rem;
  }

  .entries {
    margin-top: 2.5rem;
  }
</style>
