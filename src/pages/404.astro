---
// The not-found page.
import Base from "../layouts/Base.astro";
import TitleBlock from "../components/TitleBlock.astro";
import { revision } from "../lib/site";
---

<Base title="Page not found">
  <TitleBlock title="Page not found" subtitle="There is nothing at this address.">
    <div class="actions">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn" href="/projects/">Projects</a>
      <a class="btn" href="/about/">About / CV</a>
    </div>
    <Fragment slot="fields">
      <div>
        <dt>Status</dt>
        <dd>404</dd>
      </div>
      <div>
        <dt>Revision</dt>
        <dd>{revision}</dd>
      </div>
    </Fragment>
  </TitleBlock>
</Base>

<style>
  .actions {
    margin-top: 0.5rem;
  }
</style>
