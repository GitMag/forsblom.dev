---
// The About page, which is also the CV: everything comes from src/content/cv.yaml and site.yaml.
// It prints as the CV PDF (scripts/cv-pdf.ts): the nav, the footer and the buttons disappear, the title block
// keeps the photo and the written-out contact links, and a "Selected projects" section appears.
import Base from "../layouts/Base.astro";
import TitleBlock from "../components/TitleBlock.astro";
import Section from "../components/Section.astro";
import CvEntry from "../components/CvEntry.astro";
import { getEntry } from "astro:content";
import { listProjects, projectUrl } from "../lib/projects";
import { bareUrl, revision, roleFrom } from "../lib/site";

const site = (await getEntry("site", "site"))!.data;
const cv = (await getEntry("cv", "cv"))!.data;
const projects = await listProjects();
const role = roleFrom(site.title);
const host = Astro.site?.host ?? "";
const pdf = "/magnus-forsblom-cv.pdf";
const projectById = (id: string) => projects.find((p) => p.id === id);
---

<Base title="About / CV">
  <TitleBlock title={site.name} subtitle={`${role} · ${site.location}`} photo={site.photo} photoAlt={site.photoAlt}>
    <div class="actions">
      <a class="btn btn-primary" href={pdf} download>Download CV (PDF)</a>
    </div>
    <Fragment slot="fields">
      <div>
        <dt>Email</dt>
        <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
      </div>
      {
        site.links.map((l) => (
          <div>
            <dt>{l.label}</dt>
            <dd>
              <a href={l.url}>{bareUrl(l.url)}</a>
            </dd>
          </div>
        ))
      }
      <div>
        <dt>Revision</dt>
        <dd>{revision}</dd>
      </div>
    </Fragment>
  </TitleBlock>

  <Section title="Profile" id="profile">
    <p class="lead">{cv.intro}</p>
  </Section>

  <Section title="Work experience" id="work">
    {cv.work.map((w) => <CvEntry org={w.org} role={w.role} from={w.from} to={w.to} place={w.place} points={w.points} />)}
    {cv.earlier && <p class="earlier">{cv.earlier}</p>}
  </Section>

  <Section title="Education" id="education">
    {cv.education.map((e) => <CvEntry org={e.org} role={e.field} from={e.from} to={e.to} points={e.points} />)}
  </Section>

  <Section title="Selected projects" id="selected-projects" printOnly>
    <table class="print-projects">
      <tbody>
        {
          projects.map((p) => (
            <tr>
              <th scope="row">{p.data.title}</th>
              <td>
                {p.data.tagline} <span class="mono url">{host}{projectUrl(p)}</span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </Section>

  <Section title="Skills" id="skills">
    <table class="specs">
      <tbody>
        {
          cv.skills.map((group) => (
            <tr>
              <th scope="row">{group.group}</th>
              <td>{group.items.join(", ")}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </Section>

  <Section title="Languages" id="languages">
    <table class="languages">
      <thead>
        <tr>
          <th>Language</th>
          <th>Level</th>
        </tr>
      </thead>
      <tbody>
        {
          cv.languages.map((l) => (
            <tr>
              <th scope="row">{l.name}</th>
              <td>{l.level}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </Section>

  <Section title="Interests" id="interests">
    <p class="interests">
      {
        cv.interests.map((i, n) => {
          const p = i.project ? projectById(i.project) : undefined;
          return (
            <>
              {n > 0 && ", "}
              {i.name}
              {p && (
                <>
                  {" "}
                  (<a href={projectUrl(p)}>{p.data.title}</a>)
                </>
              )}
            </>
          );
        })
      }
    </p>
  </Section>

  <div class="no-print">
    <Section title="Contact" id="contact">
      <table class="specs contact">
        <tbody>
          <tr>
            <th scope="row">Email</th>
            <td><a href={`mailto:${site.email}`}>{site.email}</a></td>
          </tr>
          {
            site.links.map((l) => (
              <tr>
                <th scope="row">{l.label}</th>
                <td>
                  <a href={l.url}>{bareUrl(l.url)}</a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="actions"><a class="btn" href={pdf} download>Download CV (PDF)</a></p>
    </Section>
  </div>
</Base>

<style>
  .earlier {
    margin-top: 1rem;
    color: var(--ink-2);
    max-width: var(--measure);
  }

  .languages {
    max-width: 24rem;
  }

  .interests {
    max-width: var(--measure);
  }

  .contact {
    max-width: 32rem;
  }

  .contact + .actions {
    margin-top: 1.25rem;
  }

  .print-projects th {
    width: 9rem;
    white-space: nowrap;
  }

  .print-projects .url {
    color: var(--ink-2);
    font-size: 0.85em;
  }

  /* ---- The CV PDF ---- */
  @page {
    size: A4;
    margin: 13mm 15mm 15mm;
  }

  @media print {
    .lead {
      font-size: 1rem;
      max-width: none;
    }

    .earlier {
      margin-top: 0.5rem;
    }

    /* The project links in the interests line: the Selected projects table covers them. */
    .interests a::after {
      content: "";
    }
  }
</style>
